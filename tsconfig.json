{
  "compilerOptions": {
    "strict": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "dom"],
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "paths": { "~/*": ["./src/*"], "@/*": ["./src/*"] }
  },
  "files": ["./references.d.ts", "./src/main.ts", "./src/polyfills.ts"],
  "include": ["src/**/*.ts"],
  "angularCompilerOptions": { "strictTemplates": true }
}
